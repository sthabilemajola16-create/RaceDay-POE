@model System.Collections.Generic.List<System.Collections.Generic.Dictionary<string, object>>

@{ViewData["Title"]="Events";}<div class="page-title"><div class="eyebrow">THE START LINE IS YOURS</div><h1>Upcoming events</h1><p>Choose your next challenge.</p></div><div class="event-grid">@foreach(var e in Model){<article class="event-card glass"><div class="event-tag">@e.GetValueOrDefault("sportType")</div><h2>@e.GetValueOrDefault("name")</h2><p>📍 @e.GetValueOrDefault("venue"), @e.GetValueOrDefault("city")</p><p>◷ @e.GetValueOrDefault("startDateTime")</p><a class="btn primary" href="/Events/Details/@e.GetValueOrDefault("eventId")">Event details</a></article>}@if(Model.Count==0){<div class="empty glass">No events are available right now. Please check again soon.</div>}</div>