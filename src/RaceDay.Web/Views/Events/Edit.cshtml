@model RaceDay.Web.Models.EventVm
@{ViewData["Title"]="Edit event";}
<div class="page-title"><div class="eyebrow">ORGANISER WORKSPACE</div><h1>Edit event</h1></div>
<section class="glass"><form method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All"></div><label asp-for="Name"></label><input asp-for="Name"/><label asp-for="Description"></label><textarea asp-for="Description"></textarea><label asp-for="SportType"></label><select asp-for="SportType"><option>Running</option><option>Walking</option><option>Cycling</option></select><label asp-for="Venue"></label><input asp-for="Venue"/><label asp-for="City"></label><input asp-for="City"/><label asp-for="Province"></label><input asp-for="Province"/><label asp-for="StartDateTime"></label><input asp-for="StartDateTime" type="datetime-local"/><label asp-for="EndDateTime"></label><input asp-for="EndDateTime" type="datetime-local"/><label asp-for="Status"></label><select asp-for="Status"><option>Published</option><option>Draft</option><option>Cancelled</option></select><label asp-for="RouteSummary"></label><input asp-for="RouteSummary"/><button class="btn primary">Save changes</button></form></section>
