@{ViewData["Title"]="Manage categories"; int id=(int)ViewBag.EventId;}
<div class="page-title"><div class="eyebrow">ORGANISER WORKSPACE</div><h1>Event categories</h1><p>Offer age groups or distance options for participants.</p></div>
<section class="glass"><form method="post" action="/Events/AddCategory">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@id"/><label>Category name</label><input name="name" required placeholder="10 km Open"/><label>Distance (km)</label><input name="distanceKm" type="number" step=".1" min=".1" required/><label>Entry fee (ZAR)</label><input name="entryFeeZar" type="number" step=".01" min="0" required/><label>Minimum age</label><input name="minAge" type="number" min="0"/><label>Maximum age</label><input name="maxAge" type="number" min="0"/><label>Maximum participants</label><input name="maxParticipants" type="number" min="1"/><button class="btn primary">Add category</button></form><a href="/Events/Enrolments/@id">View enrolments</a></section>
