<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@ViewData["Title"] · RaceDay</title><link rel="icon" href="/images/raceday-mark.svg"><link rel="stylesheet" href="/css/site.css"></head><body><header class="nav"><a class="brand" href="/"><img src="/images/raceday-mark.svg" alt="RaceDay logo"><span>RaceDay</span></a><nav><a href="/Events">Explore events</a>@if(!string.IsNullOrEmpty(Context.Session.GetString("Role"))){<a href="/Dashboard">My dashboard</a>}@if(Context.Session.GetString("Role")=="Organiser"){<a href="/Events/Create">Create event</a>}@if(!string.IsNullOrEmpty(Context.Session.GetString("Email"))){<span class="user">@Context.Session.GetString("Email")</span><form method="post" action="/Account/Logout">@Html.AntiForgeryToken()<button class="linkbtn">Sign out</button></form>}else{<a href="/Account/Login">Sign in</a><a class="nav-cta" href="/Account/Register">Join RaceDay</a>}</nav></header><main class="container">@if(TempData["Notice"]!=null){<div class="notice">@TempData["Notice"]</div>}@RenderBody()</main><footer>© @DateTime.Now.Year RaceDay · Find your next finish line.</footer></body></html>